# Server only. The API key and URL must belong to the same provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Leave AGENT_MODE unset to use llm when a key exists, grounded otherwise.
# AGENT_MODE=grounded

# Standalone local database; optional PostgreSQL uses HODHOD_DATABASE=postgres.
HODHOD_DATABASE=sqlite
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DJANGO_SECRET_KEY locally: a persistent secret is generated in .local/.

# CSV directory: data/ if present; repository root otherwise.
# TOROB_DATA_DIR=/absolute/path/to/csv-directory
TOROB_API_PORT=8787
HODHOD_BRAIN_PORT=8790

# Optional frontend overrides: never put secrets in VITE_* variables.
VITE_AGENT_ENDPOINT=
VITE_MAP_STYLE=
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Public low-volume defaults; use hosted/self-hosted services for public deployment.
TOROB_ROUTING_CAR_URL=https://routing.openstreetmap.de/routed-car
TOROB_ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot

# Optional legacy PostgreSQL; docker-compose exposes host port 5433.
POSTGRES_DB=hodhod
POSTGRES_USER=hodhod
POSTGRES_PASSWORD=hodhod
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
