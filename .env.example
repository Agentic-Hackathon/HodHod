# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (مطابق docker-compose.yml) ---
POSTGRES_DB=hodhod
POSTGRES_USER=hodhod
POSTGRES_PASSWORD=hodhod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM ---
# anthropic  |  openai  (هر سرویس سازگار با OpenAI هم با base url قابل استفاده است)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# اختیاری: برای گیت‌وی/پروکسی یا سرویس سازگار با OpenAI
LLM_BASE_URL=
